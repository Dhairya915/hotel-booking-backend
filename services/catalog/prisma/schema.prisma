generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hotel {
  id        String   @id @default(uuid())
  name      String
  city      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rooms     Room[]
}

enum RoomType{
  SINGLE
  DOUBLE
  DELUXE
  SUITE 
}

model Room {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId] , references: [id])
  type            RoomType
  pricePerNight   Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

}